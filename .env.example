# URL và anon key của project Supabase (Project Settings → API). Dùng cho app (an toàn để lộ ra trình duyệt, đã có RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key: CHỈ dùng cho script seed / add-user chạy trên máy bạn.
# KHÔNG thêm biến này vào Vercel.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
